
name = input("Patient name: ")
consultation = float(input("Consultation charge: "))
diagnostic = float(input("Diagnostic charge: "))
treatment = float(input("Treatment charge: "))
paid = float(input("Amount paid: "))

total = consultation + diagnostic + treatment

if total >= 5000:
    concession = total * 0.10
else:
    concession = 0

final_bill = total - concession

if paid < 0 or paid > final_bill:
    print("Invalid payment amount")
else:
    balance = final_bill - paid

    print("\nPatient:", name)
    print("Total charges: Rs.", round(total, 2))
    print("Concession: Rs.", round(concession, 2))
    print("Final bill: Rs.", round(final_bill, 2))
    print("Balance: Rs.", round(balance, 2))

    if balance == 0:
        print("Classification: Fully Paid")
    elif paid > 0:
        print("Classification: Partially Paid")
    else:
        print("Classification: Unpaid")
